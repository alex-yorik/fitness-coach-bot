BOT_TOKEN=YOUR_BOT_TOKEN
ADMIN_CHAT_ID=YOUR_TELEGRAM_ID

FLASK_USERNAME=admin
# Хеш пароля админки (PBKDF2-HMAC-SHA256, 600 000 итераций).
# Сгенерировать: python -m admin.passwords
FLASK_PASSWORD_HASH=CHANGE_ME
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX

# True — cookie передаётся только по HTTPS (или на localhost);
# для демо по HTTP с внешнего адреса нужно False
SESSION_COOKIE_SECURE=True

# Адрес публикации порта админки в docker-compose:
# 127.0.0.1 — только локально (по умолчанию), 0.0.0.0 — снаружи (только за reverse-proxy/TLS)
ADMIN_BIND=127.0.0.1

# Демо-режим (зарезервирован, текущий код переменную не читает). False — обычный запуск
DEMO_MODE=False

DATABASE_PATH=/app/data/database.db

# Логи (ротация 10MB x 5 файлов, только в файл, не в stdout)
LOG_PATH=/app/logs/bot.log
WEB_LOG_PATH=/app/logs/web.log

# Health-сервер бота (порт 8001 проброшен в compose)
HEALTH_PORT=8001
