BOT_TOKEN=YOUR_BOT_TOKEN
ADMIN_CHAT_ID=YOUR_TELEGRAM_ID

FLASK_USERNAME=admin
# Хеш пароля админки (PBKDF2-HMAC-SHA256, 600 000 итераций).
# Сгенерировать: python -m admin.passwords
FLASK_PASSWORD_HASH=CHANGE_ME
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX

# В коде по умолчанию True (cookie только по HTTPS); False нужен только для
# прямого входа по HTTP не с localhost и небезопасен вне демо с вымышленными
# данными; при показе через HTTPS-туннель оставляйте True.
SESSION_COOKIE_SECURE=True

# 127.0.0.1 — по умолчанию админка закрыта; 0.0.0.0 открывает её всей сети:
# только для изолированного демо с вымышленными данными (docs/DEMO.md).
ADMIN_BIND=127.0.0.1

# true — показывать в админке баннер «DEMO — не вводите реальные персональные данные».
# Код читает эту переменную (admin/web.py → context_processor → шаблоны login.html, index.html).
# Включайте на демо-сервере. Значения: 1, true, yes (без учёта регистра).
DEMO_MODE=false

DATABASE_PATH=/app/data/database.db

# Логи (ротация 10MB x 5 файлов, только в файл, не в stdout)
LOG_PATH=/app/logs/bot.log
WEB_LOG_PATH=/app/logs/web.log

# Health-сервер бота (порт 8001 проброшен в compose)
HEALTH_PORT=8001
