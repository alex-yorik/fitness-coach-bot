BOT_TOKEN=YOUR_BOT_TOKEN
ADMIN_CHAT_ID=YOUR_TELEGRAM_ID

FLASK_USERNAME=admin
# sha256-хeш пароля админки: hmac.new(SECRET_KEY, пароль, sha256)
# сгенерировать: python3 -c "from dotenv import load_dotenv; load_dotenv(); import hmac,hashlib,os; print(hmac.new(os.environ['SECRET_KEY'].encode(), b'ваш_пароль', hashlib.sha256).hexdigest())"
FLASK_PASSWORD_HASH=CHANGE_ME
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX

# True если админка за TLS/HTTPS (fail-closed), False только для локальной разработки по HTTP
SESSION_COOKIE_SECURE=True

DATABASE_PATH=/app/data/database.db

# Логи (ротация 10MB x 5 файлов, только в файл, не в stdout)
LOG_PATH=/app/logs/bot.log
WEB_LOG_PATH=/app/logs/web.log

# Health-сервер бота (порт 8001 проброшен в compose)
HEALTH_PORT=8001
